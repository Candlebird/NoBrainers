{
  "model": "sonnet",
  "enabledMcpjsonServers":["monolith"],
  "permissions":{"allow":["mcp__monolith"]},
  "hooks": {
    "PreToolUse":  [{"matcher": "mcp__monolith__.*", "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/monolith/fix_params.py\"", "timeout": 10}]}],
    "PostToolUse": [{"matcher": "mcp__monolith__blueprint_query", "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/monolith/compact_output.py\"", "timeout": 10}]}]
  }
}
